{
  // Keep equal to the Worker's name in the Cloudflare dashboard.
  "name": "portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2025-11-01",

  /*
    `npm run build` writes the static site to out/. Cloudflare serves it
    directly, free and without invoking the Worker; the Worker runs first
    only for the paths listed in run_worker_first.
  */
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  /*
    Not secrets, so they live here where they are versioned. A deploy
    deletes plain variables that exist only in the dashboard.
    RESEND_API_KEY is the one secret: set it in the dashboard under
    Settings, Variables & Secrets. Deploys never touch secrets.
    The sender must be on a domain verified in Resend.
  */
  "vars": {
    "CONTACT_FROM": "WebForge Digital <forms@webforgedigital.dev>"
  }
}
