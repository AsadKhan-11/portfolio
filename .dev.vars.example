# Copy this file to .dev.vars (git ignores that one) to test the contact
# form locally with `npm run dev:functions`. Real values never go in this
# file, which is committed.
#
# On the live site the same three names are set in the Cloudflare Pages
# project instead: Settings, Variables and Secrets.

# Resend dashboard, API Keys. Starts with re_
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Before your domain is verified, Resend only lets you send from
# onboarding@resend.dev, and only to the email you signed up to Resend with.
CONTACT_FROM="WebForge Digital <onboarding@resend.dev>"
CONTACT_TO=the-email-you-signed-up-to-resend-with@example.com

# Once webforgedigital.dev is verified in Resend, switch to:
#   CONTACT_FROM="WebForge Digital <forms@webforgedigital.dev>"
#   CONTACT_TO=asad@webforgedigital.dev
